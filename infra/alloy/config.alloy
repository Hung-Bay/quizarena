// Grafana Alloy Configuration for QuizArena (Phase 7)
// Đọc file log Docker JSON trực tiếp từ volume log của host (không mount docker.sock)

local.file_match "docker_logs" {
  path_targets = [
    {
      __path__ = "/var/lib/docker/containers/*/*-json.log",
    },
  ]
}

loki.source.file "docker" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.docker.receiver]
}

loki.process.docker {
  // 1. Giải mã định dạng JSON của Docker log container
  stage.json {
    expressions = {
      output = "log",
      stream = "stream",
      time   = "time",
      attrs  = "attrs",
    }
  }

  // 2. Trích xuất nhãn com.docker.compose.service nếu có
  stage.json {
    source      = "attrs"
    expressions = {
      service = "\"com.docker.compose.service\"",
    }
  }

  // 3. Trích xuất log level từ chuỗi log nội bộ
  stage.regex {
    source     = "output"
    expression = "\\[(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL)\\]"
  }

  // 4. Gắn nhãn cơ bản (cardinality thấp: service, stream, level)
  // LƯU Ý BẮT BUỘC: game_id, user_id, request_id KHÔNG dùng làm nhãn Loki
  // mà được lọc qua LogQL: {service="realtime"} |= `"game_id":"..."`
  stage.labels {
    values = {
      stream  = "",
      service = "",
      level   = "",
    }
  }

  // 5. Chuyển tiếp nội dung gốc cho Loki
  stage.output {
    source = "output"
  }

  forward_to = [loki.write.local_loki.receiver]
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
