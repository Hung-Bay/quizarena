# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
APP_ENV=dev

# Postgres
POSTGRES_USER=quizarena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quizarena
DATABASE_URL=postgresql+asyncpg://quizarena:change-me@postgres:5432/quizarena

# Redis
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Gemini (lấy ở Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL_QUIZ=
GEMINI_MODEL_REPORT=
GEMINI_RPM=
GEMINI_RPD=
AI_GENERATIONS_PER_HOST_PER_DAY=5
